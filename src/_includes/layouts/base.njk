<!DOCTYPE html>
{# `client.locale` sets the document language — a client whose site is in
   Spanish sets 'es' and screen readers/search follow. #}
<html lang="{{ client.locale or 'en' }}"{% if viewportPage %} class="viewport-page"{% endif %}>
  <head>
    {% include "core/head.njk" %}

    {% block head %}{% endblock %}

    {% block schema %}
    {% include "core/schema.njk" %}
    {% endblock %}

    {% block head_extra %}
    {#- The one head tag core/head.njk does not carry: the legacy .ico that
        older browsers and some crawlers still request. #}
    <link rel="icon" href="/assets/favicons/favicon.ico" sizes="any">
{% endblock %}
  </head>

  {# `viewportPage` (set at the top of a child template) is for pages whose
     content is a single embed sized to the space under the header — the menu
     iframe. They lock the page scroll and drop the footer so the only
     scrollbar is the embed's own; without this the page is one viewport plus
     a footer and the browser shows a second, near-useless outer scrollbar. #}
  {# The centered-logo header is taller than the default bar and floats below
     the top edge on desktop, so it re-anchors --header-height (styles.scss) —
     hero padding and anchor scroll offsets follow from that one variable. #}
  <body class="font-body{% if theme.style.titleRule == 'bar' %} has-title-rule{% endif %}{% if theme.components.header == 'header_center' %} is-header-center{% endif %}{% if viewportPage %} h-svh overflow-hidden{% endif %}">
    {# Skip link: a keyboard or screen-reader visitor otherwise tabs through
       every nav label and CTA on each page before reaching the content.
       Hidden until focused, written as Tailwind focus: utilities (a
       hand-written :focus rule can lose half its selector in this build,
       leaving the link hidden for the only people who use it). z-[60]
       clears the header's z-50 and stays under the 88 layers. `main`
       takes tabindex="-1" so the jump moves focus, not just the scroll. Its
       class is marked important because the site-wide keyboard focus style
       in styles.scss would otherwise draw round the whole page. #}
    <a href="#main" class="sr-only rounded-btn focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-white focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-secondary-900 focus:shadow-card">Skip to content</a>
    {% include "components/" + theme.components.header + ".njk" %}
    <main id="main" tabindex="-1" class="!outline-none">
      {% block content %}{% endblock %}
    </main>
    {% if not viewportPage %}{% include "components/footer.njk" %}{% endif %}
    {% include "core/scripts.njk" %}
    {% block bodyEnd %}{% endblock %}
    {% block body_end_extra %}{% endblock %}
  </body>
</html>
