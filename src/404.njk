---
permalink: /404.html
solidHeader: true
eleventyExcludeFromCollections: true
noindex: true
---
{% extends "layouts/base.njk" %}

{# Not-found page. Excluded from collections so it stays out of the sitemap,
   and out of client.nav for the same reason. Whether a real 404 actually
   serves this file is host config — most static hosts pick up /404.html.
   Copy comes from client.notFound; the links are the site's own nav. #}
{% block content %}
<div class="pt-[var(--header-height)]">
  <section class="section bg-white">
    <div class="container-site">
      <div class="section-head">
        <p class="eyebrow">{{ client.notFound.eyebrow or "404" }}</p>
        <h1 class="section-title">{{ client.notFound.title or "We can't find that page" }}</h1>
        {% if client.notFound.lede %}<p class="lede">{{ client.notFound.lede }}</p>{% endif %}
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="rounded-btn border border-transparent btn-accent px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em]">{{ client.notFound.homeLabel or "Back to home" }}</a>
        {%- for item in client.nav %}
        {%- if (item.href | first) != '#' %}
        <a href="{{ item.href }}" class="rounded-btn border border-gray-300 px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-gray-700 transition-colors hover:border-gray-400 hover:bg-gray-50">{{ item.label }}</a>
        {%- endif %}
        {%- endfor %}
      </div>
    </div>
  </section>
</div>
{% endblock %}
