---
solidHeader: true
---
{% extends "layouts/base.njk" %}

{# Careers page: a short pitch beside the 88restaurants employment embed,
   which writes into the same admin the contact form does. Opt-in —
   `src/employment.11tydata.js` withholds the permalink unless
   `theme.components.employment` and `client.id` are both set. Turning it on
   also needs a `client.nav` entry pointing at /employment/; `client.seo.employment`
   is already there.

   Not `viewportPage`: the embed is 650px of form, not a full-height menu,
   and the page has copy above it that the reader needs. No hero, so
   `solidHeader` starts the bar tinted and the wrapper pads past it. #}
{% block content %}
<div class="pt-[var(--header-height)]">
  <section id="employment" class="section bg-secondary-50">
    <div class="container-site">
      <div class="section-head" data-reveal="up">
        {% if client.employment.eyebrow %}<p class="eyebrow">{{ client.employment.eyebrow }}</p>{% endif %}
        <h1 class="section-title">{{ client.employment.title or "Join Our Team" }}</h1>
        {% if client.employment.lede %}<p class="lede">{{ client.employment.lede }}</p>{% endif %}
      </div>

      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10" data-reveal="up" data-reveal-delay="1">
        {# Short on purpose: everything a candidate needs before they start
           typing. h-full + a column flex so this card matches the form card
           beside it at lg; the tagline takes mt-auto and falls to the bottom
           so it reads as a sign-off rather than a fourth bullet. #}
        <div class="lg:col-span-5">
          <div class="ground-ink flex h-full flex-col rounded-card bg-secondary-700 p-7 sm:p-9">
            {% if client.employment.pitch %}<p class="font-display text-2xl font-semibold leading-snug text-white">{{ client.employment.pitch }}</p>{% endif %}
            {% if client.employment.points.length %}
            <ul class="mt-7 space-y-4 pb-10">
              {%- for point in client.employment.points %}
              <li class="flex gap-3 text-lg/8 text-gray-200">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent-500" aria-hidden="true"></span>
                <span>{{ point }}</span>
              </li>
              {%- endfor %}
            </ul>
            {% endif %}
            {% if client.employment.tagline %}
            <p class="mt-auto inline-block self-start border-t border-accent-400 pt-5 font-display text-sm font-semibold uppercase tracking-[0.24em] text-accent-400">{{ client.employment.tagline }}</p>
            {% endif %}
          </div>
        </div>

        {# The application form paints its own card (background, corners,
           padding) from the restaurant's Forms settings, so no wrapper. Seven
           of twelve columns is ~650px at lg, above the 575px at which the
           form pairs its fields. #}
        <div class="lg:col-span-7">
          <div data-88-form="{{ client.forms.employment }}"></div>
          {% if client.employment.emailNote and client.email %}
          <p class="mt-4 text-sm text-gray-500">
            {{ client.employment.emailNote }}
            <a href="mailto:{{ client.email }}" class="font-medium text-accent-700 underline underline-offset-4">{{ client.email }}</a>.
          </p>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</div>
{% endblock %}
