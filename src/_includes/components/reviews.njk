{# Google reviews — build-time data from src/_data/reviews.js, which returns
   null until client.js has a `reviews` block, so this include is safe on
   every site. Sits on bg-secondary-50 between visit (white) and newsletter
   (primary-600) in the default order.

   assets/js/reviews.js drives the per-review "Read more" clamp and the
   "View more reviews" button. It depends on: id="reviews", the
   data-review-toggle / data-review-extra / data-reviews-more attributes, the
   review-text-N ids, and the `line-clamp-5` + `hidden` class names — restyle
   around those. review.text contains real newlines: it renders through
   `escape | nl2br` rather than the reference integration's pre-line
   whitespace approach, because this template's htmlmin transform
   (.eleventy.js) collapses literal newlines in text nodes — a <br> survives
   minification, a newline does not.

   NOTE: do NOT add schema.org Review/AggregateRating markup here — marking up
   reviews sourced from Google violates Google's structured-data policy. #}
{% if reviews and reviews.items.length %}
<section id="reviews" class="section bg-secondary-50">
  <div class="container-site">

    <div class="section-head" data-reveal="up">
      {% if client.reviews.eyebrow %}<p class="eyebrow">{{ client.reviews.eyebrow }}</p>{% endif %}
      <h2 class="section-title">{{ client.reviews.title or "What Our Guests Say" }}</h2>
      {% if reviews.summary.google.average %}
      {# Fractional-fill star row: two stacked rows, the accent one
         width-clipped to average / 5. #}
      {% set summaryPct = (reviews.summary.google.average / 5 * 100) %}
      <div class="mt-6 flex items-center justify-center gap-3">
        <span class="text-xl font-semibold text-gray-900">{{ reviews.summary.google.average }}</span>
        <span class="relative inline-flex" aria-hidden="true">
          <span class="flex text-gray-300">
            {% for i in range(5) %}<svg class="size-5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>{% endfor %}
          </span>
          <span class="absolute inset-0 flex overflow-hidden text-accent-500" style="width: {{ summaryPct }}%">
            {% for i in range(5) %}<svg class="size-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>{% endfor %}
          </span>
        </span>
        <span class="text-gray-600">from {{ reviews.summary.google.total }} Google reviews</span>
      </div>
      {% endif %}
    </div>

    <div class="card-grid" data-reveal="up" data-reveal-delay="1">
      {% for review in reviews.items %}
      <article {% if loop.index > 3 %}data-review-extra {% endif %}class="flex flex-col rounded-card bg-white p-6 shadow-card outline outline-1 outline-black/5 transition-shadow duration-300 hover:shadow-card-hover lg:px-8 lg:py-7{{ ' hidden' if loop.index > 3 }}">
        <div class="flex items-center justify-between gap-4">
          <span class="font-semibold text-gray-900">{{ review.author }}</span>
          {% if review.published_at %}
          <time datetime="{{ review.published_at }}" class="flex-shrink-0 text-sm text-gray-500">{{ review.published_at | readableDate }}</time>
          {% endif %}
        </div>
        <p class="sr-only">Rated {{ review.rating }} out of 5 stars</p>
        <span class="mt-2 flex" aria-hidden="true">
          {% for i in range(5) %}<svg class="size-4 {{ 'text-accent-500' if i < review.rating else 'text-gray-300' }}" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>{% endfor %}
        </span>
        {% if review.text %}
        <p id="review-text-{{ loop.index }}" class="mt-4 leading-relaxed text-gray-700 line-clamp-5">{{ review.text | escape | nl2br }}</p>
        <button
          type="button"
          data-review-toggle
          aria-controls="review-text-{{ loop.index }}"
          aria-expanded="false"
          class="mt-2 hidden self-start text-sm font-semibold text-accent-600 transition-colors hover:text-accent-700"
        >Read more</button>
        {% endif %}
        {% if review.url %}
        {# Platform footer — icon keyed off review.source (google only for now;
           yelp/tripadvisor icons get added here when those sources land). #}
        <a
          href="{{ review.url }}"
          target="_blank"
          rel="noopener nofollow"
          aria-label="View this review on {{ review.source | title }}"
          class="mt-auto block pt-4"
        >
          <span class="flex items-center gap-2 border-t border-gray-100 pt-4 text-sm text-gray-400 transition-colors hover:text-gray-600">
            {% if review.source == "google" %}
            <svg class="size-4 flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            {% endif %}
            View on {{ review.source | title }}
          </span>
        </a>
        {% endif %}
      </article>
      {% endfor %}
    </div>

    {% if reviews.items.length > 3 %}
    <div class="mt-12 text-center" data-reveal="up">
      <button
        type="button"
        data-reviews-more
        class="rounded-btn border border-transparent btn-accent px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em]"
      >View more reviews</button>
    </div>
    {% endif %}

  </div>
</section>
{% endif %}
